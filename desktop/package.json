{
  "name": "pes-editor-desktop",
  "productName": "PES Editor Rebuilt",
  "version": "0.44.0",
  "description": "PES Editor Rebuilt para Windows: el mismo editor de la web, con acceso a la carpeta Sider aunque esté en Archivos de programa.",
  "author": "Agustinioquino",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "io.github.agustinioquino.peseditorrebuilt",
    "productName": "PES Editor Rebuilt",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PES Editor Rebuilt",
      "artifactName": "PES-Editor-Rebuilt-Setup.exe"
    },
    "portable": {
      "artifactName": "PES-Editor-Rebuilt-Portable.exe"
    }
  }
}
